<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO-КАРТОЧКА: ТЕПЕРЬ ВЫСОТА wrap_content -->
            <androidx.cardview.widget.CardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="26dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="10dp"
                app:cardBackgroundColor="@color/card_dark">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/details_hero_bg">

                    <!-- декоративный светящийся шар -->
                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-40dp"
                        android:layout_marginEnd="-40dp"
                        android:src="@drawable/hero_orb_pulse"
                        android:scaleType="centerCrop"
                        android:alpha="0.9" />

                    <!-- основной контент -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:paddingEnd="110dp">

                        <!-- Категория -->
                        <TextView
                            android:id="@+id/tvDetailsCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Категория"
                            android:textColor="@color/gradient_end"
                            android:textSize="13sp" />

                        <!-- Заголовок -->
                        <TextView
                            android:id="@+id/tvDetailsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Модуль пространственной реконструкции"
                            android:textColor="@color/text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <!-- Краткое описание -->
                        <TextView
                            android:id="@+id/tvDetailsShort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Краткое резюме сущности."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            android:lineSpacingExtra="2dp" />

                        <!-- Чипы: без weight, карточка сама растягивается по высоте -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:gravity="start">

                            <TextView
                                android:id="@+id/tvTagType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:background="@drawable/bg_chip_info"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingLeft="14dp"
                                android:paddingRight="14dp"
                                android:text="Тип: Понятие"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTagLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:background="@drawable/bg_chip_info"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingLeft="14dp"
                                android:paddingRight="14dp"
                                android:text="Уровень: Концептуальный"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTagFocus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_info"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingLeft="14dp"
                                android:paddingRight="14dp"
                                android:text="Фокус: Среда"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- КАРТОЧКА С ПАРАМЕТРАМИ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/metricsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_dark_soft">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Параметры модуля"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Интенсивность -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Интенсивность стимулов"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvIntensityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="70 %"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbIntensity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:indeterminateOnly="false"
                            android:progressDrawable="@drawable/progress_accent" />
                    </LinearLayout>

                    <!-- Сложность сценария -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Сложность сценария"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvComplexityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="60 %"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbComplexity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:indeterminateOnly="false"
                            android:progressDrawable="@drawable/progress_accent" />
                    </LinearLayout>

                    <!-- Устойчивость реакции -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Устойчивость реакции"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvStabilityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="80 %"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbStability"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:indeterminateOnly="false"
                            android:progressDrawable="@drawable/progress_accent" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- КАРТОЧКА "ПРОФИЛЬ МОДУЛЯ" -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/card_dark_soft">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Профиль модуля"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabBehavior"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_timer_primary"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Поведение"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tabUseCases"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/btn_timer_secondary"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Области"
                            android:textAllCaps="false"
                            android:textColor="@color/gradient_end"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Описание профиля модуля."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ПОДРОБНОЕ ОПИСАНИЕ -->
            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Подробное описание"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Полное описание элемента справочника."
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:justificationMode="inter_word" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
